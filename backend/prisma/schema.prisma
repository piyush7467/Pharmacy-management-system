// Prisma Schema for PharmaPulse Pharmacy Management System
// Target Database: PostgreSQL (Neon DB Serverless Compatible)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  ADMIN
  PHARMACIST
  CASHIER
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum BatchStatus {
  ACTIVE
  QUARANTINED
  DEPLETED
  EXPIRED
}

enum StockMovementType {
  PURCHASE_RECEIPT
  SALE_DEDUCTION
  CUSTOMER_RETURN
  ADJUSTMENT_WRITE_OFF
  ADJUSTMENT_RESTOCK
  EXPIRED_DISPOSAL
}

enum CustomerType {
  GENERAL
  REGULAR
  HOSPITAL_CLINIC
  WHOLESALE_BULK
  CORPORATE_TPA
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  SPLIT
  CREDIT_LEDGER
}

enum SaleStatus {
  COMPLETED
  REFUNDED_PARTIAL
  REFUNDED_FULL
  CANCELLED
}

enum ReturnDisposition {
  RESTOCKED
  DAMAGED_DISCARDED
}

enum AdjustmentType {
  WRITE_OFF_DAMAGED
  WRITE_OFF_EXPIRED
  INVENTORY_COUNT_GAIN
  INVENTORY_COUNT_LOSS
}

// -------------------------------------------------------------
// CORE MODELS
// -------------------------------------------------------------

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique @db.VarChar(255)
  passwordHash String         @db.VarChar(255)
  fullName     String         @db.VarChar(100)
  role         Role           @default(CASHIER)
  isActive     Boolean        @default(true)
  deletedAt    DateTime?      @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  purchasesReceived   Purchase[]     @relation("PurchasesReceivedByUser")
  sales               Sale[]         @relation("SalesByCashier")
  returnsProcessed    CustomerReturn[] @relation("ReturnsProcessedByUser")
  adjustmentsApproved StockAdjustment[] @relation("AdjustmentsApprovedByUser")
  stockMovements      StockMovement[] @relation("StockMovementsByUser")
  auditLogs           AuditLog[]     @relation("AuditLogsByUser")

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @db.VarChar(255)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @db.VarChar(255)
  familyId  String   @db.Uuid
  isRevoked Boolean  @default(false)
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([familyId])
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique @db.VarChar(100)
  description String?    @db.Text
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)

  medicines Medicine[]
}

model Medicine {
  id              String   @id @default(uuid()) @db.Uuid
  categoryId      String   @db.Uuid
  name            String   @db.VarChar(200)
  genericName     String   @db.VarChar(200)
  sku             String   @unique @db.VarChar(50)
  dosageForm      String   @db.VarChar(50)
  strength        String   @db.VarChar(50)
  packageUnit     String   @db.VarChar(50)
  minReorderLevel Int      @default(20)
  defaultTaxRate  Decimal  @default(12.00) @db.Decimal(5, 2)
  therapeuticClasses String[] @default([])
  manufacturer    String?  @db.VarChar(150)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  batches       Batch[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]

  @@index([name])
  @@index([genericName])
  @@index([sku])
  @@index([categoryId])
}

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(150)
  contactPerson String?  @db.VarChar(100)
  phone         String?  @db.VarChar(20)
  email         String?  @db.VarChar(255)
  address       String?  @db.Text
  taxNumber     String?  @db.VarChar(50)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  purchases Purchase[]

  @@index([name])
}

model Purchase {
  id               String         @id @default(uuid()) @db.Uuid
  purchaseNumber   String         @unique @db.VarChar(50)
  supplierId       String         @db.Uuid
  status           PurchaseStatus @default(DRAFT)
  orderedDate      DateTime       @default(now()) @db.Timestamptz(6)
  receivedDate     DateTime?      @db.Timestamptz(6)
  subtotal         Decimal        @default(0.00) @db.Decimal(12, 2)
  taxTotal         Decimal        @default(0.00) @db.Decimal(12, 2)
  grandTotal       Decimal        @default(0.00) @db.Decimal(12, 2)
  receivedByUserId String?        @db.Uuid
  notes            String?        @db.Text
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)

  supplier       Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  receivedByUser User?          @relation("PurchasesReceivedByUser", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  items          PurchaseItem[]

  @@index([supplierId])
  @@index([purchaseNumber])
  @@index([status])
}

model PurchaseItem {
  id                String    @id @default(uuid()) @db.Uuid
  purchaseId        String    @db.Uuid
  medicineId        String    @db.Uuid
  batchNumber       String    @db.VarChar(100)
  manufacturingDate DateTime? @db.Date
  expiryDate        DateTime  @db.Date
  orderedQuantity   Int
  receivedQuantity  Int       @default(0)
  unitCost          Decimal   @db.Decimal(12, 2)
  unitSalePrice     Decimal   @db.Decimal(12, 2)
  lineTotal         Decimal   @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batches  Batch[]

  @@index([purchaseId])
  @@index([medicineId])
}

model Batch {
  id                String      @id @default(uuid()) @db.Uuid
  medicineId        String      @db.Uuid
  batchNumber       String      @db.VarChar(100)
  purchaseItemId    String?     @db.Uuid
  manufacturingDate DateTime?   @db.Date
  expiryDate        DateTime    @db.Date
  initialQuantity   Int
  currentQuantity   Int
  purchaseCost      Decimal     @db.Decimal(12, 2)
  salePrice         Decimal     @db.Decimal(12, 2)
  mrp               Decimal?    @db.Decimal(12, 2)
  status            BatchStatus @default(ACTIVE)
  createdAt         DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(6)

  medicine        Medicine          @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  purchaseItem    PurchaseItem?     @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)
  stockMovements  StockMovement[]
  saleItems       SaleItem[]
  returnItems     ReturnItem[]
  adjustments     StockAdjustment[]

  @@unique([medicineId, batchNumber])
  @@index([medicineId])
  @@index([expiryDate, currentQuantity])
  @@index([status])
}

model StockMovement {
  id                 String            @id @default(uuid()) @db.Uuid
  batchId            String            @db.Uuid
  movementType       StockMovementType
  quantityDelta      Int
  balanceAfter       Int
  referenceId        String?           @db.Uuid
  performedByUserId  String            @db.Uuid
  reason             String?           @db.Text
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)

  batch           Batch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  performedByUser User  @relation("StockMovementsByUser", fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([batchId, createdAt])
  @@index([referenceId])
  @@index([performedByUserId])
}

model Customer {
  id                 String       @id @default(uuid()) @db.Uuid
  customerCode       String       @unique @db.VarChar(50)
  type               CustomerType @default(GENERAL)
  name               String       @db.VarChar(100)
  phone              String?      @db.VarChar(20)
  email              String?      @db.VarChar(255)
  companyName        String?      @db.VarChar(150)
  taxNumber          String?      @db.VarChar(50)
  drugLicenseNo      String?      @db.VarChar(50)
  defaultDiscountPct Decimal      @default(0.00) @db.Decimal(5, 2)
  creditLimit        Decimal      @default(0.00) @db.Decimal(12, 2)
  currentBalance     Decimal      @default(0.00) @db.Decimal(12, 2)
  paymentTermsDays   Int          @default(0)
  address            String?      @db.Text
  notes              String?      @db.Text
  isActive           Boolean      @default(true)
  deletedAt          DateTime?    @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)

  sales              Sale[]       @relation("CustomerSales")

  @@index([customerCode])
  @@index([phone])
  @@index([type])
  @@index([isActive])
}

model Sale {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceNumber  String        @unique @db.VarChar(50)
  cashierId      String        @db.Uuid
  customerId     String?       @db.Uuid
  customerName   String        @default("Walk-in Customer") @db.VarChar(100)
  customerPhone  String?       @db.VarChar(20)
  subtotal       Decimal       @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal       @default(0.00) @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @default(CASH)
  status         SaleStatus    @default(COMPLETED)
  idempotencyKey String?       @unique @db.VarChar(100)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  cashier  User             @relation("SalesByCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  customer Customer?        @relation("CustomerSales", fields: [customerId], references: [id], onDelete: SetNull)
  items    SaleItem[]
  returns  CustomerReturn[]

  @@index([invoiceNumber])
  @@index([cashierId])
  @@index([customerId])
  @@index([createdAt])
  @@index([status])
}

model SaleItem {
  id          String   @id @default(uuid()) @db.Uuid
  saleId      String   @db.Uuid
  medicineId  String   @db.Uuid
  batchId     String   @db.Uuid
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  costPrice   Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @db.Decimal(5, 2)
  taxAmount   Decimal  @db.Decimal(12, 2)
  totalAmount Decimal  @db.Decimal(12, 2)

  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine    Medicine     @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch       Batch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  returnItems ReturnItem[]

  @@index([saleId])
  @@index([medicineId])
  @@index([batchId])
}

model CustomerReturn {
  id                String   @id @default(uuid()) @db.Uuid
  returnNumber      String   @unique @db.VarChar(50)
  saleId            String   @db.Uuid
  processedByUserId String   @db.Uuid
  reason            String   @db.Text
  refundAmount      Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  sale            Sale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  processedByUser User         @relation("ReturnsProcessedByUser", fields: [processedByUserId], references: [id], onDelete: Restrict)
  items           ReturnItem[]

  @@index([saleId])
  @@index([returnNumber])
}

model ReturnItem {
  id           String            @id @default(uuid()) @db.Uuid
  returnId     String            @db.Uuid
  saleItemId   String            @db.Uuid
  batchId      String            @db.Uuid
  quantity     Int
  refundAmount Decimal           @db.Decimal(12, 2)
  disposition  ReturnDisposition @default(RESTOCKED)

  customerReturn CustomerReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem       SaleItem       @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  batch          Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([saleItemId])
  @@index([batchId])
}

model StockAdjustment {
  id                String         @id @default(uuid()) @db.Uuid
  adjustmentNumber  String         @unique @db.VarChar(50)
  batchId           String         @db.Uuid
  adjustmentType    AdjustmentType
  quantityDelta     Int
  reason            String         @db.Text
  approvedByUserId  String         @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)

  batch          Batch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  approvedByUser User  @relation("AdjustmentsApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@index([adjustmentNumber])
  @@index([approvedByUserId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityName String   @db.VarChar(50)
  entityId   String   @db.VarChar(50)
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.Text
  diff       Json?    @db.JsonB
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  actor User? @relation("AuditLogsByUser", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityName, entityId])
  @@index([createdAt])
}
