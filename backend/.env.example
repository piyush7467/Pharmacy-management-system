# ========================================================
# PharmaPulse Backend Environment Configuration Template
# ========================================================

NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# --- Neon PostgreSQL Connection Strings ---
# 1. DATABASE_URL: Neon pooled connection string
DATABASE_URL="postgresql://user:password@ep-cool-pool-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. DIRECT_URL: Neon direct connection string (unpooled, used for Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Security & JWT Secrets ---
ACCESS_TOKEN_SECRET="your-super-secret-access-token-min-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# --- Cookie Security ---
COOKIE_SECRET="your-cookie-signing-secret-min-32-chars"
COOKIE_SECURE=false

# --- Logging ---
LOG_LEVEL=info
