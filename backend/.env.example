# ========================================================
# PharmaPulse Backend Environment Configuration Template
# ========================================================

NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# --- Neon PostgreSQL Connection Strings ---
# 1. DATABASE_URL: Neon pooled connection string
DATABASE_URL="postgresql://user:password@ep-pooler.region.neon.tech/neondb?sslmode=require"

# 2. DIRECT_URL: Neon direct connection string (unpooled, used for Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-direct.region.neon.tech/neondb?sslmode=require"

# --- Initial Admin Credentials (Database Seed Only) ---
ADMIN_EMAIL="admin@pharmapulse.demo"
ADMIN_PASSWORD="ReplaceWithAStrongPassword123!"

# --- Security & JWT Secrets ---
ACCESS_TOKEN_SECRET="your-super-secret-access-token-min-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# --- Cookie Security ---
COOKIE_SECRET="your-cookie-signing-secret-min-32-chars"
COOKIE_SECURE=false

# --- Brevo (Sendinblue) Transactional Email ---
BREVO_API_KEY="xkeysib-your-brevo-api-key-here"
BREVO_SENDER_EMAIL="noreply@pharmapulse.demo"
BREVO_SENDER_NAME="PharmaPulse Security"
FRONTEND_URL="http://localhost:5173"

# --- Logging ---
LOG_LEVEL=info
