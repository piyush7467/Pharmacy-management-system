# ========================================================
# PharmaPulse Environment Configuration Template
# ========================================================

# --- Backend Configuration ---
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma 7)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmapulse_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pharmapulse_db?schema=public"

# Authentication Secrets (Generate using: openssl rand -base64 32)
ACCESS_TOKEN_SECRET="your-super-secret-access-token-key-min-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Cookie Configuration
COOKIE_SECRET="your-super-secret-cookie-signing-key"
COOKIE_SECURE=false

# Logging & Telemetry
LOG_LEVEL="info"

# --- Frontend Configuration (Public) ---
VITE_API_BASE_URL="http://localhost:5000/api/v1"
